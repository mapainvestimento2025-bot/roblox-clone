{
  "rewrites": [
    { "source": "/api/db.json",         "destination": "/api/db" },
    { "source": "/api/ban/check",       "destination": "/api/check" },
    { "source": "/api/dm/summary",      "destination": "/api/summary" },
    { "source": "/api/game/delete",     "destination": "/api/delete" },
    { "source": "/api/game/visit",      "destination": "/api/visit" },
    { "source": "/api/game/vote",       "destination": "/api/vote" },
    { "source": "/api/presence/beat",   "destination": "/api/beat" },
    { "source": "/api/presence/leave",  "destination": "/api/leave" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",  "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}
