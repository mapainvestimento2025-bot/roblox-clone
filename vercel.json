{
  "functions": {
    "db.js":       { "maxDuration": 10 },
    "register.js": { "maxDuration": 10 },
    "login.js":    { "maxDuration": 10 },
    "bio.js":      { "maxDuration": 10 },
    "avatar.js":   { "maxDuration": 10 },
    "friend.js":   { "maxDuration": 10 },
    "game.js":     { "maxDuration": 10 },
    "delete.js":   { "maxDuration": 10 },
    "visit.js":    { "maxDuration": 10 },
    "vote.js":     { "maxDuration": 10 },
    "chat.js":     { "maxDuration": 10 },
    "dm.js":       { "maxDuration": 10 },
    "summary.js":  { "maxDuration": 10 },
    "presence.js": { "maxDuration": 10 },
    "beat.js":     { "maxDuration": 10 },
    "leave.js":    { "maxDuration": 10 },
    "ping.js":     { "maxDuration": 10 },
    "status.js":   { "maxDuration": 10 },
    "join.js":     { "maxDuration": 10 },
    "check.js":    { "maxDuration": 10 },
    "import.js":   { "maxDuration": 10 },
    "admin.js":    { "maxDuration": 10 },
    "stats.js":    { "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/api/ban/check",      "destination": "/check" },
    { "source": "/api/dm/summary",     "destination": "/summary" },
    { "source": "/api/game/delete",    "destination": "/delete" },
    { "source": "/api/game/visit",     "destination": "/visit" },
    { "source": "/api/game/vote",      "destination": "/vote" },
    { "source": "/api/presence/beat",  "destination": "/beat" },
    { "source": "/api/presence/leave", "destination": "/leave" },
    { "source": "/api/db",             "destination": "/db" },
    { "source": "/api/register",       "destination": "/register" },
    { "source": "/api/login",          "destination": "/login" },
    { "source": "/api/bio",            "destination": "/bio" },
    { "source": "/api/avatar",         "destination": "/avatar" },
    { "source": "/api/friend",         "destination": "/friend" },
    { "source": "/api/game",           "destination": "/game" },
    { "source": "/api/chat",           "destination": "/chat" },
    { "source": "/api/dm",             "destination": "/dm" },
    { "source": "/api/presence",       "destination": "/presence" },
    { "source": "/api/ping",           "destination": "/ping" },
    { "source": "/api/status",         "destination": "/status" },
    { "source": "/api/join",           "destination": "/join" },
    { "source": "/api/import",         "destination": "/import" },
    { "source": "/api/admin",          "destination": "/admin" },
    { "source": "/api/stats",          "destination": "/stats" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",  "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}
